<Window x:Class="Elekta.IC.Tools.SoupAnalysis.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Elekta.IC.Tools.SoupAnalysis.Desktop.Views"
    Title="Elekta IC SOUP Analysis" Width="1360" Height="880" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
    <Grid Background="{StaticResource WindowBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding AccountStatus}" Margin="0,0,12,0" />
                <Button Content="Sign In" Command="{Binding LoginCommand}" />
                <Button Content="Disconnect" Command="{Binding SignOutCommand}" ToolTip="Disconnect this tool; keep your shared Azure CLI session" />
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" ToolTip="Settings" Command="{Binding SettingsCommand}" Padding="8" />
                <Button Content="Scan Repositories" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="0" />
            </StackPanel><DockPanel>
                <Image x:Name="ApplicationLogo" Source="{StaticResource SoupAnalysisLogo}" Width="36" Height="36" Margin="0,0,12,0"
                    VerticalAlignment="Center" AutomationProperties.Name="SOUP Analysis - software package analysis" />
                <StackPanel><TextBlock Text="Elekta IC SOUP Analysis" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="ConfigurationSummary" FontSize="12" Margin="0,4,10,0" TextWrapping="Wrap">
                    <Run Text="Analysis For: " /><Run Text="{Binding AnalysisFor, Mode=OneWay}" /><Run Text=" | Platform Config Version: " /><Run Text="{Binding PlatformConfigVersion, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding AuthenticationStatus}" FontSize="12" Margin="0,4,10,0" TextWrapping="Wrap" /></StackPanel>
            </DockPanel></DockPanel>
        </Border>
        <TextBox Grid.Row="1" Text="{Binding UserError, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Foreground="#A32A35" Background="#FFF4F3" BorderThickness="0" MaxHeight="85" VerticalScrollBarVisibility="Auto">
            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="16,8,16,0" /><Style.Triggers>
                <DataTrigger Binding="{Binding UserError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers></Style></TextBox.Style>
        </TextBox>
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}" Margin="16,12,16,10">
            <TabItem Header="Repositories"><views:RepositoriesView /></TabItem>
            <TabItem Header="Analysis"><views:AnalysisView /></TabItem>
            <TabItem Header="Changes"><views:ChangeReviewView /></TabItem>
        </TabControl>
        <Expander Grid.Row="3" Header="Operation Log" Margin="16,0,16,8">
            <DataGrid ItemsSource="{Binding Logs}" Height="120" IsReadOnly="True"><DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="100" />
                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="180" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns></DataGrid>
        </Expander>
        <Border Grid.Row="4" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" /><TextBlock Text="{Binding Stage}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Elapsed}" /><TextBlock Text="{Binding ProgressCounts}" FontSize="12" /></StackPanel>
                <ProgressBar Grid.Column="2" Height="6" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue}" Maximum="{Binding ProgressMaximum}" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="Cancel" Command="{Binding CancelCommand}" Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>