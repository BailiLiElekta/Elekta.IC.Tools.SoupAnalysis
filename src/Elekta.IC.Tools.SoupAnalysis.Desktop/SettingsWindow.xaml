<Window x:Class="Elekta.IC.Tools.SoupAnalysis.Desktop.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings" Width="560" Height="300" MinWidth="480" MinHeight="280" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="Account" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
        <StackPanel Grid.Row="1">
            <TextBlock Text="Azure CLI" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="{Binding AuthenticationStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{Binding AccountStatus}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding UserError}" TextWrapping="Wrap" Foreground="#A32A35" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Sign In" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="Disconnect" Command="{Binding SignOutCommand}" ToolTip="Disconnect this tool; keep your shared Azure CLI session" />
            <Button Content="Close" IsCancel="True" Click="CloseClick" />
        </StackPanel>
    </Grid>
</Window>