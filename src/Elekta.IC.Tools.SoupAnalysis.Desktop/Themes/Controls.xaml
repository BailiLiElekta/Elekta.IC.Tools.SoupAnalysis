<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F5F6" />
    <SolidColorBrush x:Key="WorkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#E6F1F3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1B91A6" />
    <SolidColorBrush x:Key="InputBrush" Color="#EEF0F2" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CCD3D7" />
    <SolidColorBrush x:Key="TextBrush" Color="#25343A" />
    <SolidColorBrush x:Key="SoupBrush" Color="#FFF2D4" />
    <SolidColorBrush x:Key="MismatchBrush" Color="#FCE7E6" />
    <SolidColorBrush x:Key="UpgradeBrush" Color="#90CAF0" />
    <SolidColorBrush x:Key="AwaitingSelectionBrush" Color="#F5CD78" />
    <SolidColorBrush x:Key="DowngradeBrush" Color="#FFE4CC" />
    <SolidColorBrush x:Key="MixedBrush" Color="#FCE7E6" />
    <SolidColorBrush x:Key="HealthyBrush" Color="#E8F4E6" />
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style TargetType="Window">
        <Setter Property="Icon" Value="pack://application:,,,/Elekta.IC.Tools.SoupAnalysis.Desktop;component/Assets/SoupAnalysis.ico" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    </Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource WorkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E7EBED" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="42" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{StaticResource WorkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
                <Border x:Name="CellSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="CellSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CellSurface" Property="BorderBrush" Value="{StaticResource TextBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="GridCellText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="OwnershipCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Ownership}" Value="IC SOUP">
                <Setter Property="Background" Value="{StaticResource SoupBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Ownership}" Value="SharedWithPlatform">
                <Setter Property="Background" Value="{StaticResource HeaderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ActionCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Action}" Value="Upgrade">
                <Setter Property="Background" Value="{StaticResource UpgradeBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="ToolTip" Value="Upgrade: Required alignment" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Action}" Value="AwaitingSelection">
                <Setter Property="Background" Value="{StaticResource AwaitingSelectionBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="ToolTip" Value="Awaiting selection: Choose a target version before review" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Action}" Value="Downgrade">
                <Setter Property="Background" Value="{StaticResource DowngradeBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="ToolTip" Value="Downgrade: Review needed (higher version in use)" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Action}" Value="Mixed">
                <Setter Property="Background" Value="{StaticResource MixedBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="ToolTip" Value="Mixed: Contains both upgrades and downgrades" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Action}" Value="Aligned">
                <Setter Property="Background" Value="{StaticResource HealthyBrush}" />
                <Setter Property="ToolTip" Value="Aligned: Matches target baseline" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="16,8" /><Setter Property="MinHeight" Value="36" /></Style>
</ResourceDictionary>